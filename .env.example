# AI Service Configuration
# You need at least ONE of these keys for AI features to work

# Gemini API (Recommended - uses Gemini 3.6 Flash)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API (Alternative)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Foursquare API (For real Zimbabwe places)
# Already configured in the app - no need to add
# FOURSQUARE_API_KEY=fsq3FlzDfPxVuRr7+HYQ7XQyY+RqwiWYxThPyz2ITWJEVr0=
